{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],

  "timezone": "America/New_York",
  "schedule": ["* * * * 1"],
  "updateNotScheduled": false,

  "dependencyDashboard": true,
  "pinDigests": true,
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,

  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",

  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/values.*\\.ya?ml$/"]
  },

  "vulnerabilityAlerts": {
    "labels": ["security"]
  },

  "packageRules": [
    {
      "description": "Everything non-breaking in one PR",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "addLabels": ["dependencies"]
    },
    {
      "description": "Digest bumps are noisy - keep them separate",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["digest"],
      "groupName": "all digest updates",
      "groupSlug": "all-digest",
      "addLabels": ["dependencies", "digest"]
    },
    {
      "description": "Majors get their own PR, gated behind the dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["dependencies", "major"]
    },
    {
      "description": "Initial digest pinning - one big bang, then never again",
      "matchUpdateTypes": ["pin", "pinDigest"],
      "groupName": "pin dependencies to digests",
      "groupSlug": "pin-digests",
      "addLabels": ["dependencies", "pin"]
    }
  ]
}
